{
  "version": 2,
  "builds": [
    {
      "src": "api-app.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api-app.ts"
    },
    {
      "src": "/cache/(.*)",
      "dest": "/api-app.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
